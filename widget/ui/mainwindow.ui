  <property name="styleSheet">
   <string notr="true">QMainWindow { background-color: #111217; }
QWidget#root { background-color:rgb(20, 21, 26); }
QToolBar#appToolBar { background-color: #111217; border: none; spacing: 6px; padding-right: 10px; }
QToolBar#appToolBar QToolButton {
    color: #c2c9d8; font-size: 14px; border: none; border-radius: 6px;
    padding: 4px 8px; background-color: transparent;
}
QToolBar#appToolBar QToolButton:hover { background-color: rgba(255, 255, 255, 8%); }
QFrame#sidebar { border-radius: 14px; background-color: #171a22; }
QFrame#accountCard { border-radius: 10px; background-color: #1b1f2a; }
QLabel#accountLabel { color: #cdd5e6; font-size: 12px; }
QPushButton#vipButton { border: none; border-radius: 7px; background-color: #dbe8ff; color: #1a202c; font-size: 11px; font-weight: 600; padding: 7px 10px; }
QPushButton#vipButton:hover { background-color: #edf4ff; }
QPushButton#navItem, QPushButton#navItem2, QPushButton#navItem3, QPushButton#navItem4 {
    text-align: left; border: none; border-radius: 8px; color: #d0d6e5;
    background-color: transparent; font-size: 13px; padding: 10px 12px;
}
QPushButton#navItem:hover, QPushButton#navItem2:hover, QPushButton#navItem3:hover, QPushButton#navItem4:hover { background-color: #212636; }
QPushButton#activeNavItem {
    text-align: left; border: none; border-radius: 8px; color: #f3f7ff;
    background-color: #252a38; font-size: 13px; font-weight: 600; padding: 10px 12px;
}
QFrame#discoverCard { border-radius: 9px; background-color: #1c2231; }
QLabel#discoverText { color: #cfd6e6; font-size: 12px; }
QScrollArea { border: none; background-color: transparent; }
QWidget#content { background-color: transparent; }
QFrame#topBanner {
    border-radius: 18px;
    background: qlineargradient(x1:0,y1:0,x2:1,y2:0,stop:0 #2f3f80,stop:0.35 #365ea6,stop:0.7 #2f5f86,stop:1 #214044);
}
QPushButton#startButton {
    border: none; border-radius: 20px; background-color: rgba(0,0,0,45%);
    color: #f4f7ff; font-size: 18px; font-weight: 600; padding: 8px 24px;
}
QLabel#sectionTitle, QLabel#sectionTitle2 { color: #dde3ef; font-size: 22px; font-weight: 650; }
QLabel#functionIcon, QLabel#functionIcon2, QLabel#functionIcon3, QLabel#functionIcon4, QLabel#functionIcon5, QLabel#functionIcon6, QLabel#functionIcon7, QLabel#functionIcon8 {
    min-width: 54px; max-width: 54px; min-height: 54px; max-height: 54px;
    border-radius: 27px; background-color: #262a34; color: #8fd2ff; font-size: 18px; font-weight: 700;
}
QLabel#functionText, QLabel#functionText2, QLabel#functionText3, QLabel#functionText4, QLabel#functionText5, QLabel#functionText6, QLabel#functionText7, QLabel#functionText8 {
    color: #c8cfde; font-size: 13px;
}
QFrame#upgradeCard, QFrame#upgradeCard2, QFrame#upgradeCard3, QFrame#upgradeCard4 { border-radius: 14px; background-color: #1c1f27; }
QLabel#cardTitle, QLabel#cardTitle2, QLabel#cardTitle3, QLabel#cardTitle4 { color: #eef2fa; font-size: 15px; font-weight: 600; }
QLabel#cardDesc, QLabel#cardDesc2, QLabel#cardDesc3, QLabel#cardDesc4 { color: #9aa4b8; font-size: 12px; }
QFrame#draftCard { min-width: 170px; max-width: 170px; min-height: 180px; max-height: 180px; border-radius: 14px; background-color: #1f232d; }
QLabel#draftThumb { min-width: 126px; max-width: 126px; min-height: 126px; max-height: 126px; border-radius: 10px; background-color: #4f545f; color: #e3e7f0; }
QLabel#draftDate { color: #e2e6f0; font-size: 12px; font-weight: 600; }
QLabel#draftInfo { color: #99a3b6; font-size: 11px; }
QToolButton#smallTool, QToolButton#smallTool2, QToolButton#smallTool3 { border: none; color: #cfd5e2; font-size: 16px; min-width: 24px; }
</string>
